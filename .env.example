# Required runtime configuration
DATABASE_URL=
TEST_DATABASE_URL=postgresql://zenda_test:zenda_test@localhost:55432/zenda_test
JWT_SECRET=
# legacy: User.role decides; shadow: observe only; enforce: ProfessionalAccess decides for DOCTOR.
PROFESSIONAL_AUTH_ENFORCEMENT_MODE=legacy
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret from Clerk Dashboard > Webhooks > your endpoint > Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=

# HTTP security
CORS_ORIGIN=
PORT=
APP_TIMEZONE=America/Guayaquil
BOOKING_MIN_ADVANCE_MINUTES=30
BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_SLOT_STEP_MINUTES=15
APPOINTMENT_CONFIRMATION_CUTOFF_HOURS=12
LAST_MINUTE_CONFIRMATION_WINDOW_MINUTES=15
DOCTOR_APPOINTMENT_CHANGE_MIN_HOURS=24
NOTIFICATION_OUTBOX_BATCH_SIZE=50
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_POLL_SECONDS=30
NOTIFICATION_OUTBOX_WORKER_ENABLED=true
# Required in production; use a long random secret distinct from JWT_SECRET.
NOTIFICATION_OUTBOX_ENCRYPTION_KEY=
CASH_PAYMENT_GRACE_HOURS=24
CASH_CODE_MAX_ATTEMPTS=5
CASH_CODE_LOCK_MINUTES=15
CASH_PAYMENT_CODE_SECRET=

# Optional integrations
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft Outlook Calendar / Entra ID
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
# Must exactly match the redirect URI registered in Microsoft Entra ID.
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/calendar/outlook/callback
KUSHKI_PRIVATE_MERCHANT_ID=
INVITATION_ACCEPT_URL=
# Public web URLs used only in the email body; no token is logged or persisted in plaintext.
PATIENT_INVITATION_REGISTER_URL=
EMAIL_VERIFICATION_URL=
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=
DEV_CLINIC_ADMIN_EMAIL=
DEV_CLINIC_ADMIN_PASSWORD=
DEV_DOCTOR_EMAIL=
DEV_DOCTOR_PASSWORD=
DEV_DOCTOR_LICENSE_NUMBER=
