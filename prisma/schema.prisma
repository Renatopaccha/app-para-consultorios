model ScheduleBlock {
  id              String                  @id @default(uuid())
  doctorProfileId String
  clinicProfileId String?
  startsAt        DateTime                @db.Timestamptz(3)
  endsAt          DateTime                @db.Timestamptz(3)
  type            ScheduleBlockType       @default(BLOCK)
  visibility      ScheduleBlockVisibility @default(PRIVATE)
  /// Public text is intentionally restricted by the API to an allow-list.
  publicLabel     String?
  /// Never returned from public availability APIs.
  privateTitle    String?
  /// Operational note for authorized staff only; never used in availability.
  internalNotes   String?
  /// Legacy compatibility field. New writes mirror the private title here.
  reason          String?
  createdByUserId String
  updatedByUserId String?
  deletedByUserId String?
  deletedAt       DateTime?               @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)

  doctorProfile DoctorProfile            @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile?           @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  changeLogs    ScheduleBlockChangeLog[]

  @@index([doctorProfileId, startsAt])
  @@index([clinicProfileId, startsAt])
  @@index([doctorProfileId, deletedAt, startsAt])
}

model ScheduleBlockChangeLog {
  id              String                  @id @default(uuid())
  scheduleBlockId String
  changedByUserId String
