generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  CLINIC_ADMIN
  SUPERADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
}

enum PayerType {
  SELF
  CLINIC
}

model User {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  email                  String    @unique
  phone                  String?
  role                   Role      @default(PATIENT)
  
  // Auth & Notificaciones
  passwordHash           String?
  provider               String?   // "google", "apple", "local"
  fcmToken               String?   // Firebase FCM Token
  
  // Seguridad
  resetPasswordToken     String?   @unique
  resetPasswordExpires   DateTime?
  twoFactorCode          String?
  twoFactorCodeExpires   DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relaciones
  appointmentsAsPatient  Appointment[] @relation("PatientAppointments")
  reviewsGiven           Review[]      @relation("PatientReviews")
  
  @@index([email])
  @@index([resetPasswordToken])
  @@index([role])
}

model Clinic {
  id                 String             @id @default(uuid())
  name               String
  address            String
  latitude           Float?
  longitude          Float?
  phone              String?
  
  // Pagos y Suscripciones
  kushkiCardToken    String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Enlace con el sistema de autenticación (User)
  userId             String?            @unique

  // Relaciones
  affiliatedDoctors  Doctor[]
  doctors            DoctorLocation[]
  appointments       Appointment[]
  specialties        Specialty[]        
  insurances         Insurance[]        

  @@index([latitude, longitude])
  @@index([subscriptionStatus])
}

model Doctor {
  id                      String             @id @default(uuid())
  licenseNumber           String             @unique
  isVerified              Boolean            @default(false)
  consultationPrice       Float
  
  // Pagos y Suscripciones
  walletBalance           Float              @default(0)
  subscriptionStatus      SubscriptionStatus @default(INACTIVE)
  subscriptionValidUntil  DateTime?
  paidBy                  PayerType          @default(SELF)

  // Integración Google Calendar
  googleRefreshToken      String?
  googleAccessToken       String?
  tokenExpiry             DateTime?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Enlace con el sistema de autenticación (User)
  userId                  String?            @unique

  // Relaciones
  clinicId                String?
  clinic                  Clinic?            @relation(fields: [clinicId], references: [id])
  locations               DoctorLocation[]
  appointments            Appointment[]
  reviews                 Review[]
  specialties             Specialty[]        
  insurances              Insurance[]        

  @@index([isVerified])
  @@index([subscriptionStatus])
  @@index([clinicId])
}

model DoctorLocation {
  id         String    @id @default(uuid())
  doctorId   String
  clinicId   String
  isActive   Boolean   @default(true)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([isActive])
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  doctors     Doctor[]
  clinics     Clinic[]

  @@index([name])
}

model Insurance {
  id          String   @id @default(uuid())
  name        String   @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  doctors     Doctor[]
  clinics     Clinic[]

  @@index([name])
}

model Appointment {
  id                  String            @id @default(uuid())
  patientId           String
  doctorId            String
  clinicId            String
  
  date                DateTime
  time                String            
  status              AppointmentStatus @default(PENDING)
  
  // Pagos
  paymentStatus       PaymentStatus     @default(PENDING)
  paymentId           String?           @unique
  commissionAmount    Float?

  // Recordatorios
  reminder24hSent     Boolean           @default(false)
  reminder2hSent      Boolean           @default(false)
  reminder1hSent      Boolean           @default(false)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relaciones
  patient             User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor              Doctor            @relation(fields: [doctorId], references: [id])
  clinic              Clinic            @relation(fields: [clinicId], references: [id])
  review              Review?           

  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([date])
  @@index([status])
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  
  rating        Int      
  comment       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       User        @relation("PatientReviews", fields: [patientId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([patientId])
}
