generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  ASSISTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum PaymentStatus {
  PENDING_CASH
  PENDING_TRANSFER
  PAID
  WAIVED
  REFUNDED // Retenido por compatibilidad con datos existentes
}

enum AppointmentType {
  IN_PERSON
  TELEMEDICINE
  HOME_VISIT
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
}

enum PayerType {
  SELF
  CLINIC
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Currency {
  USD
}

// ---------------------------------------------------------------------------
// 1. MODELO CENTRAL: USER Y SEGURIDAD
// ---------------------------------------------------------------------------

model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  role      Role    @default(PATIENT)

  // Auth & SSO
  passwordHash String?
  provider     String? // "google", "apple", "local"
  googleId     String? @unique
  fcmToken     String? // Firebase FCM Token

  // Seguridad (Fase 2)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  twoFactorCode        String?
  twoFactorExpires     DateTime?
  is2FAEnabled         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Perfiles Especializados (Relaciones 1 a 1)
  doctorProfile    DoctorProfile?
  clinicProfile    ClinicProfile?
  assistantProfile AssistantProfile?

  // Relaciones
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  reviewsGiven          Review[]      @relation("PatientReviews")
  securityLogs          SecurityLog[]
  invitationsCreated    Invitation[]  @relation("InvitationsCreated")

  @@index([email])
  @@index([resetPasswordToken])
  @@index([role])
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. MODELOS DE PERFIL ESPECIALIZADOS
// ---------------------------------------------------------------------------

model ClinicProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  name      String
  address   String
  phone     String?
  logoUrl   String?
  latitude  Float?
  longitude Float?
  color     String? @db.VarChar(7)

  // Pagos y Suscripciones
  kushkiCardToken    String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?

  // Integración Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatedDoctors DoctorClinicWorkplace[]
  appointments      Appointment[]
  specialties       Specialty[]
  insurances        Insurance[]
  assistants        AssistantProfile[]
  services          Service[]
  scheduleBlocks    ScheduleBlock[]
  invitations       Invitation[]            @relation("ClinicInvitations")

  @@index([latitude, longitude])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String             @unique
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?
  isIndependent      Boolean            @default(false)
  bio                String?
  profileImageUrl    String?
  languages          String[]
  portfolioImages    String[]
  isAvailable        Boolean            @default(true)
  consultationPrice  Float

  // Pagos y Suscripciones
  walletBalance          Float              @default(0)
  subscriptionStatus     SubscriptionStatus @default(INACTIVE)
  subscriptionValidUntil DateTime?
  paidBy                 PayerType          @default(SELF)

  // Integración Google/Outlook Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces     DoctorClinicWorkplace[]
  appointments   Appointment[]
  reviews        Review[]
  specialties    Specialty[]
  insurances     Insurance[]
  assistants     AssistantProfile[]
  services       Service[]
  scheduleBlocks ScheduleBlock[]
  certifications Certification[]

  @@index([isVerified])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model AssistantProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  canViewFinances Boolean @default(false)

  // A quién asiste (Relaciones opcionales)
  doctorProfileId String?
  clinicProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id])
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

// ---------------------------------------------------------------------------
// 3. TABLA INTERMEDIA (EL MÉDICO HÍBRIDO)
// ---------------------------------------------------------------------------

model DoctorClinicWorkplace {
  id              String    @id @default(uuid())
  doctorProfileId String
  clinicProfileId String
  isActive        Boolean   @default(true)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile  @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  schedules     WorkSchedule[]

  @@unique([doctorProfileId, clinicProfileId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// 4. ENTIDADES DEL NEGOCIO (CITAS, RESEÑAS Y CATÁLOGOS)
// ---------------------------------------------------------------------------

model Specialty {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  doctorProfiles DoctorProfile[]
  clinicProfiles ClinicProfile[]

  @@index([name])
}

model Insurance {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  doctorProfiles DoctorProfile[]
  clinicProfiles ClinicProfile[]

  @@index([name])
}

model Appointment {
  id              String @id @default(uuid())
  patientId       String
  doctorProfileId String
  clinicProfileId String
  serviceId       String

  date             DateTime
  startTime        String
  endTime          String
  startDatetime    DateTime?         @db.Timestamptz // Fecha y hora con zona horaria integrada
  startsAt         DateTime?         @db.Timestamptz(3)
  endsAt           DateTime?         @db.Timestamptz(3)
  previousStartsAt DateTime?         @db.Timestamptz(3)
  previousEndsAt   DateTime?         @db.Timestamptz(3)
  status           AppointmentStatus @default(PENDING)
  appointmentType  AppointmentType   @default(IN_PERSON)
  notes            String?

  // Pagos
  paymentMethod                  String        @default("NONE")
  paymentStatus                  PaymentStatus @default(PENDING_CASH)
  paymentId                      String?       @unique
  verificationCode               String?       @unique
  commissionAmount               Float?
  cancellationReason             String?
  // Historical values are nullable only while legacy appointments are backfilled.
  serviceNameSnapshot            String?
  servicePriceCentsSnapshot      Int?
  serviceDurationMinutesSnapshot Int?
  currencySnapshot               Currency?
  paymentAmountCents             Int?
  paymentCurrency                Currency?

  // Recordatorios y Asistencia
  turnNumber         Int?
  isPatientConfirmed Boolean  @default(false)
  reminder24hSent    Boolean  @default(false)
  reminder2hSent     Boolean  @default(false)
  reminder1hSent     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Integración Calendarios Externos
  googleEventId  String?
  outlookEventId String?

  // Relaciones
  patient       User          @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  clinicProfile ClinicProfile @relation(fields: [clinicProfileId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])
  review        Review?

  @@index([patientId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([startsAt])
}

model ScheduleBlock {
  id              String   @id @default(uuid())
  doctorProfileId String
  clinicProfileId String?
  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  reason          String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, startsAt])
  @@index([clinicProfileId, startsAt])
}

model Review {
  id              String @id @default(uuid())
  appointmentId   String @unique
  patientId       String
  doctorProfileId String

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patient       User          @relation("PatientReviews", fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([patientId])
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float    @default(0)
  // Legacy decimal kept for API/data transition; priceCents is canonical.
  priceCents  Int?
  currency    Currency @default(USD)
  duration    Int? // en minutos
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones opcionales (un servicio puede pertenecer a un doctor o a una clínica)
  doctorProfileId String?
  clinicProfileId String?

  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

model Certification {
  id          String @id @default(uuid())
  name        String
  institution String
  year        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
}

model WorkSchedule {
  id        String  @id @default(uuid())
  weekday   Int // ISO: 0 = Lunes y 6 = Domingo
  timezone  String? // ej: "America/Guayaquil"
  startTime String // Formato "HH:MM", ej: "08:00"
  endTime   String // Formato "HH:MM", ej: "12:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workplaceId String
  workplace   DoctorClinicWorkplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@index([workplaceId])
}

model Invitation {
  id              String    @id @default(uuid())
  email           String
  role            Role
  tokenHash       String    @unique
  clinicProfileId String?
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clinicProfile ClinicProfile? @relation("ClinicInvitations", fields: [clinicProfileId], references: [id], onDelete: SetNull)
  invitedBy     User           @relation("InvitationsCreated", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
  @@index([role])
  @@index([clinicProfileId])
}
