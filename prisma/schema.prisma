generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  ASSISTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
}

enum PayerType {
  SELF
  CLINIC
}

// ---------------------------------------------------------------------------
// 1. MODELO CENTRAL: USER Y SEGURIDAD
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  email                  String    @unique
  phone                  String?
  role                   Role      @default(PATIENT)
  
  // Auth & SSO
  passwordHash           String?
  provider               String?   // "google", "apple", "local"
  googleId               String?   @unique
  fcmToken               String?   // Firebase FCM Token
  
  // Seguridad (Fase 2)
  resetPasswordToken     String?   @unique
  resetPasswordExpires   DateTime?
  twoFactorCode          String?
  twoFactorExpires       DateTime?
  is2FAEnabled           Boolean   @default(false)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Perfiles Especializados (Relaciones 1 a 1)
  doctorProfile          DoctorProfile?
  clinicProfile          ClinicProfile?
  assistantProfile       AssistantProfile?

  // Relaciones
  appointmentsAsPatient  Appointment[] @relation("PatientAppointments")
  reviewsGiven           Review[]      @relation("PatientReviews")
  securityLogs           SecurityLog[]
  
  @@index([email])
  @@index([resetPasswordToken])
  @@index([role])
}

model SecurityLog {
  id          String   @id @default(uuid())
  userId      String
  ipAddress   String
  userAgent   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. MODELOS DE PERFIL ESPECIALIZADOS
// ---------------------------------------------------------------------------

model ClinicProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  name               String
  address            String
  phone              String?
  latitude           Float?
  longitude          Float?
  
  // Pagos y Suscripciones
  kushkiCardToken    String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relaciones
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatedDoctors  DoctorClinicWorkplace[]
  appointments       Appointment[]
  specialties        Specialty[]        
  insurances         Insurance[]
  assistants         AssistantProfile[]

  @@index([latitude, longitude])
  @@index([subscriptionStatus])
}

model DoctorProfile {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  licenseNumber           String             @unique
  isVerified              Boolean            @default(false)
  isIndependent           Boolean            @default(false)
  biography               String?
  consultationPrice       Float
  
  // Pagos y Suscripciones
  walletBalance           Float              @default(0)
  subscriptionStatus      SubscriptionStatus @default(INACTIVE)
  subscriptionValidUntil  DateTime?
  paidBy                  PayerType          @default(SELF)

  // Integración Google Calendar
  googleRefreshToken      String?
  googleAccessToken       String?
  tokenExpiry             DateTime?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relaciones
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces              DoctorClinicWorkplace[]
  appointments            Appointment[]
  reviews                 Review[]
  specialties             Specialty[]        
  insurances              Insurance[]
  assistants              AssistantProfile[]

  @@index([isVerified])
  @@index([subscriptionStatus])
}

model AssistantProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  canViewFinances  Boolean  @default(false)

  // A quién asiste (Relaciones opcionales)
  doctorProfileId  String?
  clinicProfileId  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorProfile    DoctorProfile? @relation(fields: [doctorProfileId], references: [id])
  clinicProfile    ClinicProfile? @relation(fields: [clinicProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

// ---------------------------------------------------------------------------
// 3. TABLA INTERMEDIA (EL MÉDICO HÍBRIDO)
// ---------------------------------------------------------------------------

model DoctorClinicWorkplace {
  id               String   @id @default(uuid())
  doctorProfileId  String
  clinicProfileId  String
  isActive         Boolean  @default(true)
  joinedAt         DateTime @default(now())
  leftAt           DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctorProfile    DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile    ClinicProfile @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, clinicProfileId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// 4. ENTIDADES DEL NEGOCIO (CITAS, RESEÑAS Y CATÁLOGOS)
// ---------------------------------------------------------------------------

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  doctorProfiles   DoctorProfile[]
  clinicProfiles   ClinicProfile[]

  @@index([name])
}

model Insurance {
  id          String   @id @default(uuid())
  name        String   @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  doctorProfiles   DoctorProfile[]
  clinicProfiles   ClinicProfile[]

  @@index([name])
}

model Appointment {
  id                  String            @id @default(uuid())
  patientId           String
  doctorProfileId     String
  clinicProfileId     String
  
  date                DateTime
  time                String            
  status              AppointmentStatus @default(PENDING)
  
  // Pagos
  paymentStatus       PaymentStatus     @default(PENDING)
  paymentId           String?           @unique
  commissionAmount    Float?

  // Recordatorios
  reminder24hSent     Boolean           @default(false)
  reminder2hSent      Boolean           @default(false)
  reminder1hSent      Boolean           @default(false)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relaciones
  patient             User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorProfile       DoctorProfile     @relation(fields: [doctorProfileId], references: [id])
  clinicProfile       ClinicProfile     @relation(fields: [clinicProfileId], references: [id])
  review              Review?           

  @@index([patientId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([date])
  @@index([status])
}

model Review {
  id                String   @id @default(uuid())
  appointmentId     String   @unique
  patientId         String
  doctorProfileId   String
  
  rating            Int      
  comment           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointment       Appointment   @relation(fields: [appointmentId], references: [id])
  patient           User          @relation("PatientReviews", fields: [patientId], references: [id])
  doctorProfile     DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([patientId])
}
