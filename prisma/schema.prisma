generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  ASSISTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum PaymentStatus {
  PENDING_CASH
  PENDING_TRANSFER
  PAID
  WAIVED
  REFUNDED // Retenido por compatibilidad con datos existentes
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum CashPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  EXEMPTED
}

enum PaymentEventType {
  CREATED
  CODE_REISSUED
  LOOKUP_SUCCEEDED
  LOOKUP_FAILED
  CONFIRMED
  CANCELLED
  CANCELLED_AFTER_CONFIRMATION_REQUIRES_REVIEW
  REFUND_MARKED
  STATUS_CHANGED
}

enum AppointmentType {
  IN_PERSON
  TELEMEDICINE
  HOME_VISIT
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
}

enum PayerType {
  SELF
  CLINIC
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Currency {
  USD
}

enum AppointmentChangeType {
  CREATED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
}

enum PatientConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum PatientInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TurnStatus {
  WAITING
  CALLED
  DELAYED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum ScheduleBlockType {
  BLOCK
  PERSONAL
}

// ---------------------------------------------------------------------------
// 1. MODELO CENTRAL: USER Y SEGURIDAD
// ---------------------------------------------------------------------------

model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  // All new writes populate this canonical form. It stays nullable only while
  // pre-existing installations are backfilled by the migration.
  emailNormalized String? @unique
  phone     String?
  role      Role    @default(PATIENT)

  // Auth & SSO
  passwordHash String?
  provider     String? // "google", "apple", "local"
  googleId     String? @unique
  fcmToken     String? // Firebase FCM Token

  // Seguridad (Fase 2)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  twoFactorCode        String?
  twoFactorExpires     DateTime?
  is2FAEnabled         Boolean   @default(false)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpires   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Perfiles Especializados (Relaciones 1 a 1)
  doctorProfile    DoctorProfile?
  clinicProfile    ClinicProfile?
  assistantProfile AssistantProfile?

  // Relaciones
  appointmentsAsPatient       Appointment[]                @relation("PatientAppointments")
  reviewsGiven                Review[]                     @relation("PatientReviews")
  securityLogs                SecurityLog[]
  invitationsCreated          Invitation[]                 @relation("InvitationsCreated")
  patientInvitationsCreated   PatientInvitation[]          @relation("PatientInvitationsCreated")
  paymentsConfirmed           Payment[]                    @relation("PaymentConfirmedBy")
  paymentEvents               PaymentEvent[]               @relation("PaymentEventActor")
  paymentIdempotencyKeys      PaymentIdempotencyKey[]
  paymentVerificationAttempts PaymentVerificationAttempt[] @relation("PaymentAttemptActor")

  @@index([email])
  @@index([resetPasswordToken])
  @@index([role])
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. MODELOS DE PERFIL ESPECIALIZADOS
// ---------------------------------------------------------------------------

model ClinicProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  name      String
  address   String
  phone     String?
  logoUrl   String?
  latitude  Float?
  longitude Float?
  color     String? @db.VarChar(7)

  // Pagos y Suscripciones
  kushkiCardToken    String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?

  // Integración Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatedDoctors DoctorClinicWorkplace[]
  appointments      Appointment[]
  specialties       Specialty[]
  insurances        Insurance[]
  assistants        AssistantProfile[]
  services          Service[]
  scheduleBlocks    ScheduleBlock[]
  invitations       Invitation[]            @relation("ClinicInvitations")
  patientInvitations PatientInvitation[]
  confirmedPayments Payment[]               @relation("PaymentConfirmedClinic")
  paymentEvents     PaymentEvent[]          @relation("PaymentEventClinic")

  @@index([latitude, longitude])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String             @unique
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?
  isIndependent      Boolean            @default(false)
  bio                String?
  profileImageUrl    String?
  languages          String[]
  portfolioImages    String[]
  isAvailable        Boolean            @default(true)
  consultationPrice  Float

  // Pagos y Suscripciones
  walletBalance          Float              @default(0)
  subscriptionStatus     SubscriptionStatus @default(INACTIVE)
  subscriptionValidUntil DateTime?
  paidBy                 PayerType          @default(SELF)

  // Integración Google/Outlook Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces     DoctorClinicWorkplace[]
  appointments   Appointment[]
  reviews        Review[]
  specialties    Specialty[]
  insurances     Insurance[]
  assistants     AssistantProfile[]
  services       Service[]
  scheduleBlocks ScheduleBlock[]
  certifications Certification[]
  patientInvitations PatientInvitation[]

  @@index([isVerified])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model AssistantProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  canViewFinances Boolean @default(false)

  // A quién asiste (Relaciones opcionales)
  doctorProfileId String?
  clinicProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id])
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

// ---------------------------------------------------------------------------
// 3. TABLA INTERMEDIA (EL MÉDICO HÍBRIDO)
// ---------------------------------------------------------------------------

model DoctorClinicWorkplace {
  id              String    @id @default(uuid())
  doctorProfileId String
  clinicProfileId String
  isActive        Boolean   @default(true)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile  @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  schedules     WorkSchedule[]

  @@unique([doctorProfileId, clinicProfileId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// 4. ENTIDADES DEL NEGOCIO (CITAS, RESEÑAS Y CATÁLOGOS)
// ---------------------------------------------------------------------------

model Specialty {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  doctorProfiles DoctorProfile[]
  clinicProfiles ClinicProfile[]

  @@index([name])
}

model Insurance {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  doctorProfiles DoctorProfile[]
  clinicProfiles ClinicProfile[]

  @@index([name])
}

model Appointment {
  id              String @id @default(uuid())
  patientId       String?
  patientInvitationId String?
  doctorProfileId String
  clinicProfileId String
  serviceId       String

  date              DateTime
  startTime         String
  endTime           String
  startDatetime     DateTime?         @db.Timestamptz // Fecha y hora con zona horaria integrada
  startsAt          DateTime?         @db.Timestamptz(3)
  endsAt            DateTime?         @db.Timestamptz(3)
  previousStartsAt  DateTime?         @db.Timestamptz(3)
  previousEndsAt    DateTime?         @db.Timestamptz(3)
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelledByUserId String?
  checkedInAt       DateTime?         @db.Timestamptz(3)
  startedAt         DateTime?         @db.Timestamptz(3)
  completedAt       DateTime?         @db.Timestamptz(3)
  noShowAt          DateTime?         @db.Timestamptz(3)
  status            AppointmentStatus @default(PENDING)
  appointmentType   AppointmentType   @default(IN_PERSON)
  notes             String?
  // Immutable enough for agenda/reminders while the invited person has no account.
  invitedPatientFirstName String?
  invitedPatientLastName  String?
  invitedPatientEmail     String?
  invitedPatientPhone     String?

  // Pagos
  paymentMethod                  String        @default("NONE")
  paymentStatus                  PaymentStatus @default(PENDING_CASH)
  paymentId                      String?       @unique
  verificationCode               String?       @unique
  commissionAmount               Float?
  cancellationReason             String?
  // Historical values are nullable only while legacy appointments are backfilled.
  serviceNameSnapshot            String?
  servicePriceCentsSnapshot      Int?
  serviceDurationMinutesSnapshot Int?
  currencySnapshot               Currency?
  paymentAmountCents             Int?
  paymentCurrency                Currency?

  // Recordatorios y Asistencia
  turnNumber                 Int?
  isPatientConfirmed         Boolean                   @default(false)
  patientConfirmationStatus  PatientConfirmationStatus @default(PENDING)
  patientConfirmedAt         DateTime?                 @db.Timestamptz(3)
  confirmationDeadlineAt     DateTime?                 @db.Timestamptz(3)
  confirmationReminderSentAt DateTime?                 @db.Timestamptz(3)
  reminder24hSent            Boolean                   @default(false)
  reminder2hSent             Boolean                   @default(false)
  reminder1hSent             Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  // Integración Calendarios Externos
  googleEventId  String?
  outlookEventId String?

  // Relaciones
  patient       User?                  @relation("PatientAppointments", fields: [patientId], references: [id])
  patientInvitation PatientInvitation? @relation(fields: [patientInvitationId], references: [id])
  doctorProfile DoctorProfile          @relation(fields: [doctorProfileId], references: [id])
  clinicProfile ClinicProfile          @relation(fields: [clinicProfileId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  review        Review?
  changeLogs    AppointmentChangeLog[]
  turn          AppointmentTurn?
  cashPayment   Payment?

  @@index([patientId])
  @@index([patientInvitationId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([startsAt])
}

model PatientInvitation {
  id              String                  @id @default(uuid())
  email           String
  emailNormalized String
  firstName       String
  lastName        String
  phone           String?
  tokenHash       String                  @unique
  status          PatientInvitationStatus @default(PENDING)
  expiresAt       DateTime                @db.Timestamptz(3)
  acceptedAt      DateTime?               @db.Timestamptz(3)
  revokedAt       DateTime?               @db.Timestamptz(3)
  invitedByUserId String
  doctorProfileId String?
  clinicProfileId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  invitedBy    User           @relation("PatientInvitationsCreated", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([emailNormalized, status])
  @@index([expiresAt])
  @@index([doctorProfileId, clinicProfileId])
}

model Payment {
  id                         String            @id @default(uuid())
  appointmentId              String            @unique
  method                     PaymentMethod
  status                     CashPaymentStatus @default(PENDING)
  amountCents                Int
  currency                   Currency
  verificationCodeHash       String?           @unique
  verificationCodeLast4      String?
  codeExpiresAt              DateTime          @db.Timestamptz(3)
  failedVerificationAttempts Int               @default(0)
  lockedUntil                DateTime?         @db.Timestamptz(3)
  confirmedAt                DateTime?         @db.Timestamptz(3)
  confirmedByUserId          String?
  confirmedClinicId          String?
  cancelledAt                DateTime?         @db.Timestamptz(3)
  cancellationReason         String?
  requiresReview             Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  appointment          Appointment                  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  confirmedBy          User?                        @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedClinic      ClinicProfile?               @relation("PaymentConfirmedClinic", fields: [confirmedClinicId], references: [id], onDelete: SetNull)
  events               PaymentEvent[]
  idempotencyKeys      PaymentIdempotencyKey[]
  verificationAttempts PaymentVerificationAttempt[]

  @@index([status, method])
  @@index([confirmedAt])
  @@index([codeExpiresAt])
  @@index([confirmedClinicId])
}

model PaymentEvent {
  id             String             @id @default(uuid())
  paymentId      String
  eventType      PaymentEventType
  previousStatus CashPaymentStatus?
  newStatus      CashPaymentStatus?
  actorUserId    String?
  clinicId       String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?          @relation("PaymentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  clinic  ClinicProfile? @relation("PaymentEventClinic", fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}

model PaymentIdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  scope        String
  userId       String
  paymentId    String
  responseBody Json?
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([key, scope, userId])
  @@index([paymentId, createdAt])
}

model PaymentVerificationAttempt {
  id          String   @id @default(uuid())
  paymentId   String?
  actorUserId String?
  ipHash      String
  success     Boolean  @default(false)
  createdAt   DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?    @relation("PaymentAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([ipHash, createdAt])
  @@index([paymentId, createdAt])
}

model AppointmentTurn {
  id              String      @id @default(uuid())
  appointmentId   String      @unique
  doctorProfileId String
  clinicProfileId String
  localDate       String
  turnNumber      Int
  queueOrder      Int
  status          TurnStatus  @default(WAITING)
  assignedAt      DateTime    @default(now())
  calledAt        DateTime?   @db.Timestamptz(3)
  delayedAt       DateTime?   @db.Timestamptz(3)
  startedAt       DateTime?   @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, clinicProfileId, localDate, turnNumber])
  @@unique([doctorProfileId, clinicProfileId, localDate, queueOrder])
  @@index([doctorProfileId, clinicProfileId, localDate, status])
}

model AppointmentChangeLog {
  id               String                @id @default(uuid())
  appointmentId    String
  changedByUserId  String
  changeType       AppointmentChangeType
  previousStartsAt DateTime?             @db.Timestamptz(3)
  previousEndsAt   DateTime?             @db.Timestamptz(3)
  newStartsAt      DateTime?             @db.Timestamptz(3)
  newEndsAt        DateTime?             @db.Timestamptz(3)
  previousStatus   AppointmentStatus?
  newStatus        AppointmentStatus?
  reason           String?
  createdAt        DateTime              @default(now())
  appointment      Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model ScheduleBlock {
  id              String   @id @default(uuid())
  doctorProfileId String
  clinicProfileId String?
  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  type            ScheduleBlockType @default(BLOCK)
  reason          String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, startsAt])
  @@index([clinicProfileId, startsAt])
}

model Review {
  id              String @id @default(uuid())
  appointmentId   String @unique
  patientId       String
  doctorProfileId String

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patient       User          @relation("PatientReviews", fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([patientId])
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float    @default(0)
  // Legacy decimal kept for API/data transition; priceCents is canonical.
  priceCents  Int?
  currency    Currency @default(USD)
  duration    Int? // en minutos
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones opcionales (un servicio puede pertenecer a un doctor o a una clínica)
  doctorProfileId String?
  clinicProfileId String?

  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

model Certification {
  id          String @id @default(uuid())
  name        String
  institution String
  year        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
}

model WorkSchedule {
  id        String  @id @default(uuid())
  weekday   Int // ISO: 0 = Lunes y 6 = Domingo
  timezone  String? // ej: "America/Guayaquil"
  startTime String // Formato "HH:MM", ej: "08:00"
  endTime   String // Formato "HH:MM", ej: "12:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workplaceId String
  workplace   DoctorClinicWorkplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@index([workplaceId])
}

model Invitation {
  id              String    @id @default(uuid())
  email           String
  role            Role
  tokenHash       String    @unique
  clinicProfileId String?
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clinicProfile ClinicProfile? @relation("ClinicInvitations", fields: [clinicProfileId], references: [id], onDelete: SetNull)
  invitedBy     User           @relation("InvitationsCreated", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
  @@index([role])
  @@index([clinicProfileId])
}
