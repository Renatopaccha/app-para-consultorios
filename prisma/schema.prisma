model Appointment {
  id                  String  @id @default(uuid())
  patientId           String?
  patientInvitationId String?
  doctorProfileId     String
  clinicProfileId     String
  serviceId           String

  date                    DateTime
  startTime               String
  endTime                 String
  startDatetime           DateTime?         @db.Timestamptz // Fecha y hora con zona horaria integrada
  startsAt                DateTime?         @db.Timestamptz(3)
  endsAt                  DateTime?         @db.Timestamptz(3)
  previousStartsAt        DateTime?         @db.Timestamptz(3)
  previousEndsAt          DateTime?         @db.Timestamptz(3)
  cancelledAt             DateTime?         @db.Timestamptz(3)
  cancelledByUserId       String?
  checkedInAt             DateTime?         @db.Timestamptz(3)
  startedAt               DateTime?         @db.Timestamptz(3)
  completedAt             DateTime?         @db.Timestamptz(3)
  noShowAt                DateTime?         @db.Timestamptz(3)
  status                  AppointmentStatus @default(PENDING)
  appointmentType         AppointmentType   @default(IN_PERSON)
  notes                   String?
  // Immutable enough for agenda/reminders while the invited person has no account.
  invitedPatientFirstName String?
  invitedPatientLastName  String?
  invitedPatientEmail     String?
  invitedPatientPhone     String?

  // Pagos
  paymentMethod                  String        @default("NONE")
  paymentStatus                  PaymentStatus @default(PENDING_CASH)
  paymentId                      String?       @unique
  verificationCode               String?       @unique
  commissionAmount               Float?
  cancellationReason             String?
  cancellationReasonCode         String?
  cancellationInternalNote       String?
  cancellationPatientMessage     String?
  // Historical values are nullable only while legacy appointments are backfilled.
  serviceNameSnapshot            String?
  servicePriceCentsSnapshot      Int?
  serviceDurationMinutesSnapshot Int?
  currencySnapshot               Currency?
  paymentAmountCents             Int?
  paymentCurrency                Currency?

  // Recordatorios y Asistencia
  turnNumber                 Int?
  isPatientConfirmed         Boolean                   @default(false)
  patientConfirmationStatus  PatientConfirmationStatus @default(PENDING)
  patientConfirmedAt         DateTime?                 @db.Timestamptz(3)
  confirmationDeadlineAt     DateTime?                 @db.Timestamptz(3)
  confirmationReminderSentAt DateTime?                 @db.Timestamptz(3)
  reminder24hSent            Boolean                   @default(false)
  reminder2hSent             Boolean                   @default(false)
  reminder1hSent             Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  // Integración Calendarios Externos
  googleEventId  String?
  outlookEventId String?

  // Relaciones
  patient           User?                  @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  patientInvitation PatientInvitation?     @relation(fields: [patientInvitationId], references: [id], onDelete: Restrict)
  doctorProfile     DoctorProfile          @relation(fields: [doctorProfileId], references: [id])
  clinicProfile     ClinicProfile          @relation(fields: [clinicProfileId], references: [id])
  service           Service                @relation(fields: [serviceId], references: [id])
  review            Review?
  changeLogs        AppointmentChangeLog[]
  turn              AppointmentTurn?
  cashPayment       Payment?

  @@index([patientId])
  @@index([patientInvitationId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([startsAt])
  @@index([servicePriceCentsSnapshot], map: "Appointment_servicePriceCentsSnapshot_idx")
  @@index([confirmationDeadlineAt], map: "Appointment_confirmationDeadlineAt_idx")
}

model PatientInvitation {
  id              String                  @id @default(uuid())
  email           String
  emailNormalized String
  firstName       String
  lastName        String
  phone           String?
  tokenHash       String                  @unique
  status          PatientInvitationStatus @default(PENDING)
  expiresAt       DateTime                @db.Timestamptz(3)
  acceptedAt      DateTime?               @db.Timestamptz(3)
  revokedAt       DateTime?               @db.Timestamptz(3)
  invitedByUserId String
  doctorProfileId String?
  clinicProfileId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  invitedBy     User           @relation("PatientInvitationsCreated", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id], onDelete: SetNull)
  appointments  Appointment[]

  @@index([emailNormalized, status])
  @@index([expiresAt])
  @@index([doctorProfileId, clinicProfileId])
}

model Payment {
  id                         String            @id @default(uuid())
  appointmentId              String            @unique
  method                     PaymentMethod
  status                     CashPaymentStatus @default(PENDING)
  amountCents                Int
  currency                   Currency
  verificationCodeHash       String?           @unique
  verificationCodeLast4      String?
  codeExpiresAt              DateTime          @db.Timestamptz(3)
  failedVerificationAttempts Int               @default(0)
  lockedUntil                DateTime?         @db.Timestamptz(3)
  confirmedAt                DateTime?         @db.Timestamptz(3)
  confirmedByUserId          String?
  confirmedClinicId          String?
  cancelledAt                DateTime?         @db.Timestamptz(3)
  cancellationReason         String?
  requiresReview             Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  appointment          Appointment                  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  confirmedBy          User?                        @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedClinic      ClinicProfile?               @relation("PaymentConfirmedClinic", fields: [confirmedClinicId], references: [id], onDelete: SetNull)
  events               PaymentEvent[]
  idempotencyKeys      PaymentIdempotencyKey[]
  verificationAttempts PaymentVerificationAttempt[]

  @@index([status, method])
  @@index([confirmedAt])
  @@index([codeExpiresAt])
  @@index([confirmedClinicId])
}

model PaymentEvent {
  id             String             @id @default(uuid())
  paymentId      String
  eventType      PaymentEventType
  previousStatus CashPaymentStatus?
  newStatus      CashPaymentStatus?
  actorUserId    String?
  clinicId       String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?          @relation("PaymentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  clinic  ClinicProfile? @relation("PaymentEventClinic", fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}

model PaymentIdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  scope        String
  userId       String
  paymentId    String
  responseBody Json?
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([key, scope, userId])
  @@index([paymentId, createdAt])
}

model PaymentVerificationAttempt {
  id          String   @id @default(uuid())
  paymentId   String?
  actorUserId String?
  ipHash      String
  success     Boolean  @default(false)
  createdAt   DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?    @relation("PaymentAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([ipHash, createdAt])
  @@index([paymentId, createdAt])
}

model AppointmentTurn {
  id              String      @id @default(uuid())
  appointmentId   String      @unique
  doctorProfileId String
  clinicProfileId String
  localDate       String
  turnNumber      Int
  queueOrder      Int
  status          TurnStatus  @default(WAITING)
  assignedAt      DateTime    @default(now()) @db.Timestamptz(3)
  calledAt        DateTime?   @db.Timestamptz(3)
  delayedAt       DateTime?   @db.Timestamptz(3)
  startedAt       DateTime?   @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, clinicProfileId, localDate, turnNumber], map: "AppointmentTurn_doctor_clinic_date_number_key")
  @@unique([doctorProfileId, clinicProfileId, localDate, queueOrder], map: "AppointmentTurn_doctor_clinic_date_order_key")
  @@index([doctorProfileId, clinicProfileId, localDate, status], map: "AppointmentTurn_queue_idx")
}

model AppointmentChangeLog {
  id               String                @id @default(uuid())
  appointmentId    String
  changedByUserId  String
