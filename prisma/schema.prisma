generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  ASSISTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum PaymentStatus {
  PENDING_CASH
  PENDING_TRANSFER
  PAID
  WAIVED
  REFUNDED // Retenido por compatibilidad con datos existentes
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum CashPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  EXEMPTED
}

enum PaymentEventType {
  CREATED
  CODE_REISSUED
  LOOKUP_SUCCEEDED
  LOOKUP_FAILED
  CONFIRMED
  CANCELLED
  CANCELLED_AFTER_CONFIRMATION_REQUIRES_REVIEW
  REFUND_MARKED
  STATUS_CHANGED
}

enum AppointmentType {
  IN_PERSON
  TELEMEDICINE
  HOME_VISIT
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  INACTIVE
}

enum PayerType {
  SELF
  CLINIC
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ClinicType {
  CLINIC
  INDEPENDENT_PRACTICE
}

enum ProfessionCode {
  MEDICINE
  DENTISTRY
  PSYCHOLOGY
  NURSING
  OTHER
}

enum ProfessionalTitle {
  DR
  DRA
  DENTIST_MALE
  DENTIST_FEMALE
  PSYCHOLOGIST_MALE
  PSYCHOLOGIST_FEMALE
  LICENSED_MALE
  LICENSED_FEMALE
  OTHER
}

enum Currency {
  USD
}

enum AppointmentChangeType {
  CREATED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
}

enum PatientConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum PatientInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TurnStatus {
  WAITING
  CALLED
  DELAYED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum ScheduleBlockType {
  BLOCK
  PERSONAL
}

enum ScheduleBlockVisibility {
  PRIVATE
  PUBLIC_LABEL
}

enum ScheduleBlockChangeType {
  CREATED
  UPDATED
  UNBLOCKED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CertificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum AuthIdentityLinkEvent {
  LINKED
  LINK_REJECTED
  COLLISION
  UNLINKED
  SUSPENDED
}

enum ProfessionalApplicationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum ProfessionalCredentialType {
  PRIMARY_DEGREE
  SPECIALTY
  SUBSPECIALTY
  MASTER
  PHD
  OTHER_RELEVANT
}

enum CredentialOwnershipStatus {
  CLAIMED
  DISPUTED
  RELEASED
}

enum CredentialVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CredentialDocumentKind {
  PRIMARY_EVIDENCE
  SUPPORTING_EVIDENCE
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  REJECTED
  ERROR
}

enum ApplicationAssetCategory {
  AVATAR
  PRACTICE_INTERIOR
  PRACTICE_EXTERIOR
}

enum ApplicationAssetModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  CITY
}

enum ProfessionalApplicationReviewAction {
  SUBMITTED
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  REOPENED
}

enum RegulatoryDocumentType {
  NATIONAL_ID
  PASSPORT
  OTHER
}

enum RegulatoryIdentityVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProfessionalAccessStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ProfessionalAccessSource {
  APPLICATION_APPROVAL
  LEGACY_BACKFILL
  ADMINISTRATIVE_REPAIR
}

enum ProfessionalAccessAuditAction {
  ACTIVATED
  SUSPENDED
  REACTIVATED
  REVOKED
  REPAIRED
}

enum UserRoleAssignmentSource {
  PROFESSIONAL_APPROVAL
  LEGACY_BACKFILL
  ADMINISTRATIVE
  INVITATION
}

// ---------------------------------------------------------------------------
// 1. MODELO CENTRAL: USER Y SEGURIDAD
// ---------------------------------------------------------------------------

model User {
  id              String  @id @default(uuid())
  firstName       String
  lastName        String
  email           String  @unique
  // Canonical identity used for all authentication and uniqueness checks.
  emailNormalized String  @unique
  phone           String?
  role            Role    @default(PATIENT)

  // Auth & SSO
  // External identity only. User.id remains the canonical Zenda identifier.
  clerkUserId  String? @unique
  passwordHash String?
  provider     String? // "google", "apple", "local"
  googleId     String? @unique
  fcmToken     String? // Firebase FCM Token

  // Seguridad (Fase 2)
  resetPasswordToken         String?   @unique
  resetPasswordExpires       DateTime?
  twoFactorCode              String?
  twoFactorExpires           DateTime?
  is2FAEnabled               Boolean   @default(false)
  emailVerifiedAt            DateTime? @db.Timestamptz(3)
  emailVerificationTokenHash String?   @unique
  emailVerificationExpires   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Perfiles Especializados (Relaciones 1 a 1)
  doctorProfile    DoctorProfile?
  clinicProfile    ClinicProfile?
  assistantProfile AssistantProfile?

  // Relaciones
  appointmentsAsPatient          Appointment[]                      @relation("PatientAppointments")
  reviewsGiven                   Review[]                           @relation("PatientReviews")
  securityLogs                   SecurityLog[]
  invitationsCreated             Invitation[]                       @relation("InvitationsCreated")
  patientInvitationsCreated      PatientInvitation[]                @relation("PatientInvitationsCreated")
  paymentsConfirmed              Payment[]                          @relation("PaymentConfirmedBy")
  paymentEvents                  PaymentEvent[]                     @relation("PaymentEventActor")
  paymentIdempotencyKeys         PaymentIdempotencyKey[]
  paymentVerificationAttempts    PaymentVerificationAttempt[]       @relation("PaymentAttemptActor")
  notifications                  UserNotification[]
  certificationsReviewed         Certification[]                    @relation("CertificationReviewer")
  certificationAuditEvents       CertificationAuditLog[]            @relation("CertificationAuditActor")
  identityLinkAudits             AuthIdentityLinkAudit[]            @relation("AuthIdentityLinkTarget")
  identityLinkActions            AuthIdentityLinkAudit[]            @relation("AuthIdentityLinkActor")
  professionalApplications       ProfessionalApplication[]
  professionalCredentials        ProfessionalCredential[]           @relation("ProfessionalCredentialOwner")
  credentialsVerified            ProfessionalCredential[]           @relation("ProfessionalCredentialVerifier")
  professionalReviewActions      ProfessionalApplicationReviewLog[] @relation("ProfessionalApplicationReviewActor")
  regulatoryIdentities           ProfessionalRegulatoryIdentity[]   @relation("RegulatoryIdentityOwner")
  regulatoryIdentitiesVerified   ProfessionalRegulatoryIdentity[]   @relation("RegulatoryIdentityVerifier")
  professionalAccess             ProfessionalAccess?                @relation("ProfessionalAccessOwner")
  professionalAccessUpdates      ProfessionalAccess[]               @relation("ProfessionalAccessUpdater")
  professionalAccessAuditActions ProfessionalAccessAuditLog[]       @relation("ProfessionalAccessAuditActor")
  roleAssignments                UserRoleAssignment[]

  @@index([email])
  @@index([resetPasswordToken])
  @@index([role])
}

/// Immutable audit trail for manual identity-link operations. It intentionally
/// contains no credential, JWT, raw IP address, or Clerk payload.
model AuthIdentityLinkAudit {
  id          String                @id @default(uuid())
  userId      String?
  clerkUserId String
  event       AuthIdentityLinkEvent
  actorUserId String?
  reasonCode  String?
  requestId   String?
  createdAt   DateTime              @default(now())

  user  User? @relation("AuthIdentityLinkTarget", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("AuthIdentityLinkActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([clerkUserId, createdAt])
  @@index([event, createdAt])
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. MODELOS DE PERFIL ESPECIALIZADOS
// ---------------------------------------------------------------------------

model ClinicProfile {
  id        String     @id @default(uuid())
  userId    String     @unique
  name      String
  address   String
  phone     String?
  logoUrl   String?
  latitude  Float?
  longitude Float?
  color     String?    @db.VarChar(7)
  type      ClinicType @default(CLINIC)

  // Pagos y Suscripciones
  kushkiCardToken    String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?

  // Integración Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatedDoctors  DoctorClinicWorkplace[]
  appointments       Appointment[]
  specialties        Specialty[]
  insurances         Insurance[]
  assistants         AssistantProfile[]
  services           Service[]
  scheduleBlocks     ScheduleBlock[]
  invitations        Invitation[]            @relation("ClinicInvitations")
  patientInvitations PatientInvitation[]
  confirmedPayments  Payment[]               @relation("PaymentConfirmedClinic")
  paymentEvents      PaymentEvent[]          @relation("PaymentEventClinic")

  @@index([latitude, longitude])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  licenseNumber      String             @unique
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?
  isIndependent      Boolean            @default(false)
  bio                String?
  profileImageUrl    String?
  professionCode     ProfessionCode?
  displayTitle       ProfessionalTitle?
  customDisplayTitle String?            @db.VarChar(40)
  languages          String[]
  portfolioImages    String[]
  isAvailable        Boolean            @default(true)
  consultationPrice  Float

  // Pagos y Suscripciones
  walletBalance          Float              @default(0)
  subscriptionStatus     SubscriptionStatus @default(INACTIVE)
  subscriptionValidUntil DateTime?
  paidBy                 PayerType          @default(SELF)

  // Integración Google/Outlook Calendar
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   DateTime?
  outlookRefreshToken String?
  outlookAccessToken  String?
  outlookTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces         DoctorClinicWorkplace[]
  appointments       Appointment[]
  reviews            Review[]
  specialties        Specialty[]
  insurances         Insurance[]
  assistants         AssistantProfile[]
  services           Service[]
  scheduleBlocks     ScheduleBlock[]
  certifications     Certification[]
  patientInvitations PatientInvitation[]
  professionalAccess ProfessionalAccess?

  @@index([isVerified])
  @@index([subscriptionStatus])
  @@index([verificationStatus])
}

model AssistantProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  canViewFinances Boolean @default(false)

  // A quién asiste (Relaciones opcionales)
  doctorProfileId String?
  clinicProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id])
  clinicProfile ClinicProfile? @relation(fields: [clinicProfileId], references: [id])

  @@index([doctorProfileId])
  @@index([clinicProfileId])
}

// ---------------------------------------------------------------------------
// 3. TABLA INTERMEDIA (EL MÉDICO HÍBRIDO)
// ---------------------------------------------------------------------------

model DoctorClinicWorkplace {
  id              String    @id @default(uuid())
  doctorProfileId String
  clinicProfileId String
  isActive        Boolean   @default(true)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile  @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  schedules     WorkSchedule[]

  @@unique([doctorProfileId, clinicProfileId])
  @@index([doctorProfileId])
  @@index([clinicProfileId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// 4. ENTIDADES DEL NEGOCIO (CITAS, RESEÑAS Y CATÁLOGOS)
// ---------------------------------------------------------------------------

model HealthProfession {
  id                      String   @id @default(uuid())
  code                    String   @unique @db.VarChar(40)
  name                    String   @db.VarChar(120)
  nameNormalized          String   @unique @db.VarChar(120)
  isActive                Boolean  @default(true)
  requiresSpecialty       Boolean  @default(false)
  credentialPolicyVersion Int      @default(1)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  specialties  Specialty[]
  authorities  RegistrationAuthority[]
  applications ProfessionalApplication[]

  @@index([isActive, sortOrder])
}

model RegistrationAuthority {
  id                 String   @id @default(uuid())
  countryCode        String   @db.Char(2)
  registryNamespace  String   @db.VarChar(100)
  name               String   @db.VarChar(180)
  nameNormalized     String   @db.VarChar(180)
  healthProfessionId String?
  isVerified         Boolean  @default(false)
  isActive           Boolean  @default(true)
  sourceReference    String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  healthProfession HealthProfession?        @relation(fields: [healthProfessionId], references: [id], onDelete: Restrict)
  credentials      ProfessionalCredential[]

  @@unique([countryCode, registryNamespace])
  @@index([countryCode, isActive, nameNormalized])
  @@index([healthProfessionId])
}

model Institution {
  id              String   @id @default(uuid())
  countryCode     String   @db.Char(2)
  name            String   @db.VarChar(180)
  nameNormalized  String   @db.VarChar(180)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  sourceReference String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  credentials ProfessionalCredential[]

  @@unique([countryCode, nameNormalized])
  @@index([countryCode, isActive, nameNormalized])
}

model Language {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(16)
  name           String   @db.VarChar(80)
  nameNormalized String   @unique @db.VarChar(80)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  applications ProfessionalApplicationLanguage[]

  @@index([isActive, nameNormalized])
}

model Specialty {
  id                 String  @id @default(uuid())
  name               String
  description        String?
  healthProfessionId String
  code               String  @db.VarChar(80)
  nameNormalized     String  @db.VarChar(160)
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  healthProfession HealthProfession                   @relation(fields: [healthProfessionId], references: [id], onDelete: Restrict)
  doctorProfiles   DoctorProfile[]
  clinicProfiles   ClinicProfile[]
  applications     ProfessionalApplicationSpecialty[]

  @@unique([healthProfessionId, code])
  @@unique([healthProfessionId, nameNormalized])
  @@index([name])
  @@index([healthProfessionId, code])
  @@index([healthProfessionId, isActive, nameNormalized])
}

model ProfessionalApplication {
  id                  String                        @id @default(uuid())
  userId              String
  cycleNumber         Int
  status              ProfessionalApplicationStatus @default(DRAFT)
  healthProfessionId  String?
  legalGivenNames     String?                       @db.VarChar(160)
  legalFamilyNames    String?                       @db.VarChar(160)
  primaryPhoneE164    String?                       @db.VarChar(20)
  alternatePhoneE164  String?                       @db.VarChar(20)
  practiceCountryCode String?                       @db.Char(2)
  publicBio           String?                       @db.VarChar(1000)
  currentRevision     Int                           @default(1)
  lastVisitedStep     Int                           @default(1)
  submittedAt         DateTime?                     @db.Timestamptz(3)
  decidedAt           DateTime?                     @db.Timestamptz(3)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(3)

  user                 User                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  healthProfession     HealthProfession?                   @relation(fields: [healthProfessionId], references: [id], onDelete: Restrict)
  specialties          ProfessionalApplicationSpecialty[]
  credentials          ProfessionalApplicationCredential[]
  regulatoryIdentities ProfessionalRegulatoryIdentity[]
  location             ProfessionalApplicationLocation?
  languages            ProfessionalApplicationLanguage[]
  assets               ProfessionalApplicationAsset[]
  snapshots            ProfessionalApplicationSnapshot[]
  reviewLogs           ProfessionalApplicationReviewLog[]

  @@unique([userId, cycleNumber])
  @@index([userId, status])
  @@index([status, submittedAt, createdAt])
  @@index([healthProfessionId, status])
}

model ProfessionalApplicationSpecialty {
  id            String   @id @default(uuid())
  applicationId String
  specialtyId   String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  specialty   Specialty               @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([applicationId, specialtyId])
  @@index([specialtyId])
}

model ProfessionalCredential {
  id                           String                       @id @default(uuid())
  userId                       String
  credentialType               ProfessionalCredentialType
  countryCode                  String                       @db.Char(2)
  exactTitle                   String                       @db.VarChar(200)
  institutionId                String?
  institutionNameSnapshot      String                       @db.VarChar(180)
  registrationAuthorityId      String?
  authorityNameSnapshot        String?                      @db.VarChar(180)
  registrationNumberOriginal   String?                      @db.VarChar(120)
  registrationNumberNormalized String?                      @db.VarChar(120)
  issuedAt                     DateTime?                    @db.Date
  expiresAt                    DateTime?                    @db.Date
  ownershipStatus              CredentialOwnershipStatus    @default(CLAIMED)
  verificationStatus           CredentialVerificationStatus @default(UNVERIFIED)
  verifiedAt                   DateTime?                    @db.Timestamptz(3)
  verifiedByUserId             String?
  verificationSource           String?                      @db.VarChar(200)
  deletedAt                    DateTime?                    @db.Timestamptz(3)
  createdAt                    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                     @updatedAt @db.Timestamptz(3)

  user                  User                                @relation("ProfessionalCredentialOwner", fields: [userId], references: [id], onDelete: Restrict)
  institution           Institution?                        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  registrationAuthority RegistrationAuthority?              @relation(fields: [registrationAuthorityId], references: [id], onDelete: Restrict)
  verifiedBy            User?                               @relation("ProfessionalCredentialVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  applications          ProfessionalApplicationCredential[]
  documents             CredentialDocument[]

  @@unique([countryCode, registrationAuthorityId, registrationNumberNormalized], map: "ProfessionalCredential_registry_identity_key")
  @@index([userId, deletedAt])
  @@index([registrationAuthorityId, registrationNumberNormalized])
  @@index([verificationStatus, createdAt])
}

model ProfessionalApplicationCredential {
  id            String   @id @default(uuid())
  applicationId String
  credentialId  String
  isPrimary     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  credential  ProfessionalCredential  @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([applicationId, credentialId])
  @@index([credentialId])
}

model CredentialDocument {
  id              String                 @id @default(uuid())
  credentialId    String
  kind            CredentialDocumentKind @default(PRIMARY_EVIDENCE)
  storageProvider String                 @db.VarChar(40)
  publicId        String                 @db.VarChar(500)
  resourceType    String                 @db.VarChar(20)
  format          String                 @db.VarChar(20)
  mimeType        String                 @db.VarChar(100)
  sizeBytes       Int
  checksumSha256  String                 @db.Char(64)
  pageCount       Int?
  scanStatus      DocumentScanStatus     @default(PENDING)
  scannedAt       DateTime?              @db.Timestamptz(3)
  deletedAt       DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)

  credential ProfessionalCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([storageProvider, publicId])
  @@index([credentialId, deletedAt])
  @@index([scanStatus, createdAt])
}

model ProfessionalApplicationLocation {
  id                  String            @id @default(uuid())
  applicationId       String            @unique
  name                String?           @db.VarChar(160)
  countryCode         String?           @db.Char(2)
  administrativeArea1 String?           @db.VarChar(120)
  administrativeArea2 String?           @db.VarChar(120)
  city                String?           @db.VarChar(120)
  street1             String?           @db.VarChar(200)
  street2             String?           @db.VarChar(200)
  reference           String?           @db.VarChar(300)
  postalCode          String?           @db.VarChar(20)
  floorNumber         Int?
  officeLabel         String?           @db.VarChar(40)
  instructions        String?           @db.VarChar(500)
  latitude            Decimal?          @db.Decimal(9, 6)
  longitude           Decimal?          @db.Decimal(9, 6)
  locationPrecision   LocationPrecision @default(APPROXIMATE)
  providerType        String?           @db.VarChar(40)
  providerPlaceId     String?           @db.VarChar(500)
  confirmedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([countryCode, administrativeArea1, city])
  @@index([latitude, longitude])
}

model ProfessionalApplicationLanguage {
  id            String   @id @default(uuid())
  applicationId String
  languageId    String
  proficiency   String?  @db.VarChar(40)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  language    Language                @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([applicationId, languageId])
  @@index([languageId])
}

model ProfessionalApplicationAsset {
  id               String                           @id @default(uuid())
  applicationId    String
  category         ApplicationAssetCategory
  storageProvider  String                           @db.VarChar(40)
  publicId         String                           @db.VarChar(500)
  resourceType     String                           @db.VarChar(20)
  format           String                           @db.VarChar(20)
  mimeType         String                           @db.VarChar(100)
  sizeBytes        Int
  width            Int
  height           Int
  checksumSha256   String                           @db.Char(64)
  sortOrder        Int                              @default(0)
  moderationStatus ApplicationAssetModerationStatus @default(PENDING)
  deletedAt        DateTime?                        @db.Timestamptz(3)
  createdAt        DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                         @updatedAt @db.Timestamptz(3)

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([storageProvider, publicId])
  @@index([applicationId, category, sortOrder])
  @@index([applicationId, deletedAt])
  @@index([moderationStatus, createdAt])
}

model ProfessionalApplicationSnapshot {
  id            String   @id @default(uuid())
  applicationId String
  revision      Int
  schemaVersion Int
  payload       Json
  payloadHash   String   @db.Char(64)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application        ProfessionalApplication            @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reviewLogs         ProfessionalApplicationReviewLog[]
  professionalAccess ProfessionalAccess?

  @@unique([applicationId, revision])
  @@index([applicationId, createdAt])
}

model ProfessionalAccess {
